{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.ts": {
      "includeFiles": "data/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/**/*.ts": {
      "includeFiles": "data/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/analyze-project",
      "destination": "/api/analyze-project.ts"
    },
    {
      "source": "/api/analyze-project/(.*)",
      "destination": "/api/analyze-project.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
